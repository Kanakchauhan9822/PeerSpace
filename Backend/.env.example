# Copy to .env and fill in your own credentials. Never commit .env.
MONGO_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@YOUR_CLUSTER/peerspace
JWT_SECRET=replace-with-a-long-random-secret
CLIENT_ORIGIN=http://localhost:3000
PORT=3000
# Use the exact URL, port and transport supplied by your TURN provider.
TURN_URL=turn:YOUR_TURN_SERVER:3478
TURN_USERNAME=replace-me
TURN_PASSWORD=replace-me
# Compose sets NODE_ENV=production. Leave unset for npm run dev.

# Optional: trusted reverse proxy hop count or addresses. Leave unset locally.
# TRUST_PROXY=1
